# Credential-less local development only. Never select memory in production.
GRILL_STORE=memory

# Recommended on a public deployment: its canonical HTTPS origin.
# GRILL_PUBLIC_ORIGIN=https://your-service.example

# For durable development or production, set GRILL_STORE=supabase and both:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-server-only-service-role-key

# Other hosts only: enable this solely behind an ingress that overwrites
# incoming X-Forwarded-For, X-Forwarded-Host, and X-Forwarded-Proto.
# Otherwise all clients share an unknown-IP budget and origin uses Host.
# GRILL_TRUST_PROXY=1
